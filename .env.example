# 光途Work API 环境变量
# 复制为项目根目录或 apps/api 下的 .env 后填写，不要提交真实密钥

# 邮箱验证码（当前默认通道）。QQ 邮箱 SMTP 可发往任意收件箱，但投递不稳定。
# 官网用户账号目前限制为 @qq.com，输入 QQ 号会自动补全。
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=
SMTP_PASS=
SMTP_FROM=光途Work <your@qq.com>
# 未配置 SMTP 时验证码打在 API 日志。生产请设为 0
# GT_MAIL_ALLOW_MOCK=0

# 阿里云短信（审核通过后再填）
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_TEMPLATE_PARAM=code
ALIYUN_SMS_REGION=cn-hangzhou
# GT_SMS_ALLOW_MOCK=0

# 上游模型 Key 不要写在这里。请登录运营后台「供应商」粘贴保存。

# 第三方连接器 OAuth（可选）。配好后客户端点 + 会打开浏览器授权。
# 回调地址填：http://127.0.0.1:8787/v1/connectors/<id>/oauth/callback
# 例如 github 为 http://127.0.0.1:8787/v1/connectors/github/oauth/callback
# 测试环境 80 端口被占用时，对外地址要带 8787，并让进程监听所有网卡
# GT_API_HOST=0.0.0.0
# GT_SHOP_URL=http://43.139.61.253:8787
# GT_API_PUBLIC_URL=http://43.139.61.253:8787
# GT_API_PUBLIC_URL=http://127.0.0.1:8787
# GT_GITHUB_CLIENT_ID=
# GT_GITHUB_CLIENT_SECRET=
# GT_FEISHU_APP_ID=
# GT_FEISHU_APP_SECRET=
# GT_DINGTALK_CLIENT_ID=
# GT_DINGTALK_CLIENT_SECRET=
# GT_GOOGLE_CLIENT_ID=
# GT_GOOGLE_CLIENT_SECRET=
